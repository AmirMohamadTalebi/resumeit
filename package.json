{
  "name": "resumeit",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "start": "node server.cjs",
    "check:database": "node tests/database-check.cjs",
    "check:auth": "node tests/auth-check.cjs",
    "check:sms": "node tests/smsir-check.cjs && node tests/otp-check.cjs",
    "check:dashboard": "node tests/dashboard-check.cjs",
    "check:auth-ui": "node tests/auth-ui-check.cjs",
    "check:auth-motion": "node tests/auth-motion-check.cjs",
    "check:auth-mobile": "node tests/auth-mobile-check.cjs",
    "check:oauth": "node tests/oauth-check.cjs",
    "check:security": "node tests/security-check.cjs",
    "test": "npm run check:security && npm run check:auth && npm run check:sms && npm run check:oauth",
    "check:ui": "npm run check:dashboard && npm run check:auth-ui && npm run check:auth-mobile && npm run check:auth-motion && node tests/site-content-check.cjs"
  },
  "dependencies": {
    "mysql2": "3.24.5"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
