PORT=5077
HOST=0.0.0.0
NODE_ENV=production
PUBLIC_ORIGIN=https://resumeit.ir
# Number of reverse proxies in front of Node (nginx/LiteSpeed/Passenger = 1). Leave 0 when Node faces the internet directly;
# otherwise every visitor shares the proxy's address and login/SMS limits lock out the whole site.
TRUST_PROXY=0
# Verified phone that becomes the first owner on an installation without one. Kept in host secrets, never in source.
OWNER_PHONE=
# Site-wide OTP SMS budget per day (default 100).
SMS_DAILY_LIMIT=
# Turn on only after every subdomain (published pages, mail, etc.) is served over HTTPS.
HSTS_INCLUDE_SUBDOMAINS=false
# On start, copy page images that are still third-party HTTPS addresses onto ResumeIt (set false to skip).
LOCALIZE_EXTERNAL_IMAGES=true
# MySQL pool size (default 8). Lower it if the host limits max_user_connections.
MYSQL_CONNECTION_LIMIT=8
# Memory for served page images in megabytes (default 64).
MEDIA_CACHE_MB=64
# Optional one-time provisioning; only a salted scrypt hash, never a plaintext password.
BOOTSTRAP_PHONE=
BOOTSTRAP_PASSWORD_HASH=
# Local .env is loaded by the server. On the host, use environment settings.
SMSIR_API_KEY=
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
# Optional one-time, read-only migration from the old host database.
SQLITE_MIGRATION_PATH=

# Approved verification template; sender is selected by SMS.ir.
SMSIR_TEMPLATE_ID=357964
SMSIR_CODE_PARAMETER=CODE
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Enable only after SEP approves the terminal and the host's outbound IP.
SEP_ENABLED=true
SEP_TERMINAL_ID=

# Set the approved Zibal merchant ID in host secrets; test merchant is rejected.
ZIBAL_MERCHANT_ID=
# Optional emergency pause; valid merchant enables Zibal by default.
# ZIBAL_ENABLED=false

# Optional, opt-in notification delivery. Never reuse the login OTP template.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMSIR_NOTIFICATION_TEMPLATE_ID=
SMSIR_NOTIFICATION_PARAMETER=TITLE
# Generate a persistent VAPID pair on the host; never commit its private key.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
