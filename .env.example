PORT=5077
HOST=0.0.0.0
PUBLIC_ORIGIN=https://your-domain.example
# Optional one-time provisioning; only a salted scrypt hash, never a plaintext password.
BOOTSTRAP_PHONE=
BOOTSTRAP_PASSWORD_HASH=
# Local .env is loaded by the server. On the host, use environment settings.
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=
# Exact parameter name from your approved SMS.ir template (case matters).
SMSIR_CODE_PARAMETER=
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
# Optional one-time, read-only migration from the old host database.
SQLITE_MIGRATION_PATH=

# Preferred sender for ordinary SMS; template Verify does not accept a sender.
SMSIR_LINE_NUMBER=3000626252
